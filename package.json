{
  "name": "ai-webtools",
  "private": true,
  "version": "1.0.0",
  "description": "Edge/Chrome MV3 side panel extension for API mocking, dynamic request/response mutation and form auto-filling.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:panel && npm run build:scripts",
    "build:panel": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "watch:scripts": "node scripts/build-scripts.mjs --watch",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:ext": "node tests/e2e/run-extension.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/chrome": "^0.0.328",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  }
}
