{
  "manifest_version": 3,
  "name": "DevTool: API Mutator & Form Filler",
  "version": "1.0.0",
  "description": "Per-tab Side Panel for API mocking, dynamic response mutation, and auto-filling forms.",
  "minimum_chrome_version": "119",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "unlimitedStorage",
    "tabs"
  ],
  "action": {
    "default_title": "Open Dev Panel for this tab"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "interceptor.main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the current form from the active profile"
    }
  }
}
